        "sendTo": "mauricio.hena@gometrix.dev",
        "subject": "=📊 Board Manager Report – Sprints Gometrix {{ $now.format('dd/MM/yyyy') }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:840px;margin:auto;padding:28px;color:#1a1a1a;line-height:1.6\">\n{{ $json.output\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')\n  .replace(/\n/g,'<br>')\n  .replace(/^# (.+)/gm,'<h1 style=\"color:#1a3c5e;border-bottom:2px solid #1a3c5e;padding-bottom:6px;margin-top:0\">$1</h1>')\n  .replace(/^## (.+)/gm,'<h2 style=\"color:#1a3c5e;margin-top:24px\">$1</h2>')\n  .replace(/^### (.+)/gm,'<h3 style=\"color:#2e6da4;margin-top:16px\">$1</h3>')\n  .replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>')\n  .replace(/^- (.+)/gm,'&bull; $1')\n}}\n<hr style=\"margin-top:36px;border:none;border-top:1px solid #ddd\">\n<p style=\"color:#999;font-size:11px\">Generado automáticamente · Gometrix AI Board Manager · {{ $now.format('dd/MM/yyyy HH:mm') }}</p>\n</div>",
        "options": {}
