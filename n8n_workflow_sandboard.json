        "sendTo": "mauricio.hena@gometrix.dev",
        "subject": "=📊 Board Manager Report – Sprints Gometrix {{ $now.format('dd/MM/yyyy') }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:800px;margin:auto;padding:24px;color:#222\">\n{{ $json.output\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')\n  .replace(/\\n/g,'<br>')\n  .replace(/^# (.+)/gm,'<h1 style=\"color:#1a3c5e;border-bottom:2px solid #1a3c5e;padding-bottom:4px\">$1</h1>')\n  .replace(/^## (.+)/gm,'<h2 style=\"color:#1a3c5e;margin-top:20px\">$1</h2>')\n  .replace(/^### (.+)/gm,'<h3 style=\"color:#2e6da4\">$1</h3>')\n  .replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>')\n}}\n<hr style=\"margin-top:32px;border:none;border-top:1px solid #ddd\">\n<p style=\"color:#888;font-size:11px;margin-top:8px\">\n  Reporte generado automáticamente · Gometrix AI Board Manager · {{ $now.format('dd/MM/yyyy HH:mm') }}\n</p></div>",
        "options": {}
      }
