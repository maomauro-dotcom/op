      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $json.id }}",
        "format": "full",
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      }
    },
    {
      "id": "node-005",
      "name": "Separar Adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        180
      ],
      "parameters": {
        "jsCode": "const items = [];\nconst data = $input.first();\nconst binary = data.binary || {};\nconst attKeys = Object.keys(binary).filter(k => k.startsWith('attachment_'));\n\nif (attKeys.length === 0) {\n  return [{ json: { ...data.json, noAttachments: true } }];\n}\n\nfor (const key of attKeys) {\n  const mime = binary[key].mimeType || '';\n  const fname = binary[key].fileName || '';\n  if (mime.includes('pdf') || fname.toLowerCase().endsWith('.pdf')) {\n    items.push({\n      json: {\n        messageId: data.json.id,\n        subject: data.json.subject || '',\n        from: data.json.from || '',\n        fileName: fname || key\n      },\n      binary: { pdf_attachment: binary[key] }\n    });\n  }\n}\n\nreturn items.length > 0 ? items : [{ json: { ...data.json, noPdfs: true } }];"
      }
    },
    {
      "id": "node-006",
