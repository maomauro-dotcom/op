    {
      "id": "14e0ebf6-9124-4a4a-bacf-e43b99fefa03",
      "name": "Descargar Adjuntos PDF",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1160,
        260
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "BcCP5GZ88MtfQNIj",
          "name": "Gmail account"
        }
      },
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $json.id }}",
        "format": "full",
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      }
    },
    {
      "id": "node-005",
      "name": "Separar Adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        260
      ],
      "parameters": {
        "jsCode": "// Separar adjuntos PDF en items individuales\nconst items = [];\nconst data = $input.first();\nconst binary = data.binary || {};\nconst attKeys = Object.keys(binary).filter(k => k.startsWith('attachment_'));\n\nif (attKeys.length === 0) {\n  // Sin adjuntos: devolver item marcado para continuar el loop\n  return [{ json: { _skipPdf: true, subject: data.json.subject || '', from: data.json.from || '' } }];\n}\n\nfor (const key of attKeys) {\n  const mime = binary[key].mimeType || '';\n  const fname = (binary[key].fileName || key).toLowerCase();\n  if (mime.includes('pdf') || fname.endsWith('.pdf')) {\n    items.push({\n      json: {\n        subject: data.json.subject || '',\n        from: data.json.from || '',\n        fileName: binary[key].fileName || key\n      },\n      binary: { pdf_attachment: binary[key] }\n    });\n  }\n}\n\nreturn items.length > 0\n  ? items\n  : [{ json: { _skipPdf: true, subject: data.json.subject || '', from: data.json.from || '' } }];"
      }
    },
    {
      "id": "node-006",
      "name": "Extraer Texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1680,
        260
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "pdf_attachment"
      }
    },
    {
      "id": "node-009",
      "name": "Acumular Sprint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Guardar texto de cada PDF en static data y continuar loop\nconst stored = $getWorkflowStaticData('global');\nif (!Array.isArray(stored.sprints)) stored.sprints = [];\n\nfor (const item of $input.all()) {\n  if (item.json._skipPdf) continue;\n  const text = (item.json.text || item.json.data || '').trim();\n  if (text.length > 20) {\n    stored.sprints.push({\n      text,\n      subject: item.json.subject || 'Sin asunto',\n      from:    item.json.from    || 'gometrix.dev',\n      fileName: item.json.fileName || 'sprint.pdf'\n    });\n  }\n}\n\n// Devolver UN solo item para continuar el loop de SplitInBatches\nreturn [{ json: { _acumulado: stored.sprints.length } }];"
      }
    },
    {
      "id": "node-008",
      "name": "Preparar Prompt Board Manager",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        600
      ],
      "parameters": {
        "jsCode": "// Leer todos los sprints acumulados y construir prompt\nconst stored = $getWorkflowStaticData('global');\nconst sprints = stored.sprints || [];\nstored.sprints = []; // limpiar para siguiente ejecución\n\nconst fecha = new Date().toLocaleDateString('es-CO', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'\n});\n\nif (sprints.length === 0) {\n  return [{ json: {\n    prompt: `No se recibieron reportes de sprint con PDF esta semana (${fecha}). Por favor verificar que los correos de gometrix.dev tengan archivos PDF adjuntos.`,\n    sprintCount: 0, fecha\n  }}];\n}\n\nlet prompt = `FECHA DE REVISIÓN: ${fecha}\\nTOTAL DE REPORTES RECIBIDOS: ${sprints.length}\\n\\n=== REPORTES DE SPRINT PARA ANÁLISIS ===\\n\\n`;\n\nsprints.forEach((s, i) => {\n  prompt += `--- REPORTE ${i + 1} ---\\nAsunto: ${s.subject}\\nDe: ${s.from}\\nArchivo: ${s.fileName}\\n\\nContenido:\\n${s.text}\\n\\n`;\n});\n\nreturn [{ json: { prompt, sprintCount: sprints.length, fecha, reportDate: new Date().toISOString() } }];"
      }
    },
    {
      "id": "2bbcdb9f-7b61-4db3-928a-941081fc7b93",
      "name": "AI Board Manager",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.1,
      "position": [
        1420,
        600
      ],
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "Eres un experto Board Manager de proyectos de software en Gometrix. Analiza los reportes de sprint recibidos por correo y crea un REPORTE BOARD MANAGER clasificando los equipos de más completo a menos completo.\n\nESTRUCTURA OBLIGATORIA:\n\n# REPORTE BOARD MANAGER — REVISIÓN DE SPRINTS GOMETRIX\n**Fecha:** [fecha del reporte]\n**Reportes Analizados:** [número total]\n\n---\n\n## RANKING DE COMPLETITUD DE SPRINTS\n\n### #1 [NOMBRE EQUIPO] — [XX%] Completitud\n**Descripción del sprint:** [3-4 líneas resumiendo el trabajo realizado]\n**Logros clave:**\n- [logro 1]\n- [logro 2]\n- [logro 3 máximo]\n**Áreas de mejora:**\n- [área 1]\n- [área 2 máximo]\n\n[Repetir bloque para cada sprint, de mayor a menor completitud]\n\n---\n\n## RESUMEN EJECUTIVO GLOBAL\n[Párrafo de 3-5 líneas sobre el estado general de todos los sprints esta semana]\n\n## RECOMENDACIONES PARA LA DIRECCIÓN\n1. [Recomendación accionable 1]\n2. [Recomendación accionable 2]\n3. [Recomendación accionable 3]\n\n## ALERTAS Y RIESGOS CRÍTICOS\n- [Riesgo o bloqueo identificado — si no hay, escribir \"Sin alertas críticas esta semana\"]\n\n---\nUsa tono profesional y ejecutivo. Sé específico con datos y porcentajes cuando los reportes los incluyan. Si un reporte no tiene porcentaje de completitud explícito, estímalo basándote en el contenido.",
          "maxIterations": 5
        }
      }
    },
