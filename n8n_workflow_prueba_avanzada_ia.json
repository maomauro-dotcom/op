        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "node-format-doc",
      "name": "📝 Formatear Documento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 200],
      "parameters": {
        "jsCode": "// Recibe body con { texto, titulo } desde el webhook\n// y formatea para insertar en el Vector Store.\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  const texto = body.texto || body.content || body.text || '';\n  const titulo = body.titulo || body.title || body.filename || 'Documento sin título';\n\n  if (!texto.trim()) {\n    return [{ json: { error: 'No se encontró texto. Envía { \"texto\": \"...\", \"titulo\": \"...\" }' } }];\n  }\n\n  results.push({\n    json: {\n      pageContent: texto,\n      metadata: {\n        titulo,\n        fecha_carga: new Date().toISOString(),\n        fuente: 'webhook'\n      }\n    }\n  });\n}\n\nreturn results;"
      }
    },
    {
      "id": "node-vector-store-insert",
      "name": "💾 Cargar en Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1,
      "position": [680, 200],
      "parameters": {
        "mode": "insert"
      }
    },
    {
