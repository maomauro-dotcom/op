  "nodes": [
    {
      "id": "node-upload-webhook",
      "name": "📤 Subir Documento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 200],
      "webhookId": "upload-documento-rag",
      "parameters": {
        "httpMethod": "POST",
